<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <org.microg.gms.ui.SwitchBarPreference
        android:title="@string/pref_wearable_keep_connected"
        android:key="pref_wearable_keep_connected"
        android:persistent="false" />

    <Preference
        android:icon="@drawable/ic_info_outline"
        android:key="pref_wearable_permission"
        android:title="@string/pref_wearable_permission_title"
        android:summary="@string/pref_wearable_permission_summary"
        app:isPreferenceVisible="false"
        tools:isPreferenceVisible="true" />

    <org.microg.gms.ui.TextPreference
        android:selectable="false"
        app:iconSpaceReserved="false"
        android:summary="@string/pref_wearable_intro" />

    <PreferenceCategory
        android:layout="@layout/preference_category_no_label"
        app:iconSpaceReserved="false">
        <Preference
            android:key="pref_wearable_status"
            android:enabled="false"
            android:title="@string/pref_info_status"
            tools:summary="Connected to Google Pixel Watch 2"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

</PreferenceScreen>
